import std.io
import std.math

// 1. Decorators and Bindings
@bind(printf)
void print(string s, int i) {}

@mangle
void secret_func() {
    printf("Shhh!\n");
}

// 2. Classes with init and dinit
class Player {
    string name;
    int score;

    void init() {
        printf("Player initialized\n");
    }

//    void dinit() {
//        printf("Player %s destroyed\n", self.name);
//    }

    void addScore(int points) {
        self.score = self.score + points;
    }
}

// 3. Impl blocks for primitive types
impl int {
    int square() {
        return self * self;
    }
}

// 4. Operator Overloading
operator int ] int {
    // Custom "max" operator
    if (a > b) return a;
    return b;
}

int main() {
    // Automatic constructor
    Player p1;
    p1.name = "Jules";
    p1.score = 0;

    p1.addScore(10);
    print("Score: %d\n", p1.score);

    // Primitive impl
    int x = 5;
    int x2 = x.square();
    print("5 squared is %d\n", x2);

    // Custom operator
    int m = 10 ] 20;
    print("Max of 10 and 20 is %d\n", m);

    if (1) {
        Player p2;
        p2.name = "Temporary";
    } // p2.dinit() called here automatically

    if (1 == 1) {
        return 0;
    }
    print("FAIL: Should have returned\n", 0);

    return 0;
} // p1.dinit() called here automatically
