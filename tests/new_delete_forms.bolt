import stdio;

class Plain {
    public int x;
    public void print() { printf("plain %d\n", self.x); }
}

class Owned {
    public int v;
    public void dinit() { printf("dinit %d\n", self.v); }
}

int main() {
    Plain a = new Plain();
    a.x = 3;
    a.print();
    delete a;

    Plain* b = new Plain();
    b.x = 4;
    b.print();
    delete b;

    Owned c = new Owned();
    c.v = 5;
    delete c;

    Owned* d = new Owned();
    d.v = 6;
    delete d;

    Owned e;
    e.v = 7;

    return 0;
}
