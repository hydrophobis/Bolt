import stdio;

int main() {
    // Test string concatenation
    string s1 = "Hello";
    string s2 = "World";
    string s3 = s1 + ", " + s2 + "!";
    printf("String concat: %s\n", s3);

    // Test string equality
    if (s3 == "Hello, World!") {
        printf("String equality: PASSED\n");
    } else {
        printf("String equality: FAILED\n");
    }

    // Test string + int concatenation
    int count = 42;
    string s4 = "Count: " + count;
    printf("String + int: %s\n", s4);

    // Test string assignment
    string s5 = "Original";
    s5 = "Modified";
    printf("String assignment: %s\n", s5);

    // Test string += operator
    string s6 = "Start";
    s6 += " End";
    printf("String +=: %s\n", s6);

    return 0;
}
