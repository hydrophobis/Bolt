import std.io

enum TestEnum {
    ONE,
    TWO
};

struct TestStruct {
    int one;
};

union TestUnion {
    char a;
    int b;
};

int main() {
    int a = (int)'\1';
    switch (a) {
        case 1:
            printf("%i\n", 0);
            break;
    }

    for (int i = 0; i < 4; i++) {
        printf("%i\n", i);
    }
}