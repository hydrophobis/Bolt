import stdio;

int main() {
    for (int i = 0, j = 10; i < 3; i++) {
        printf("%d%d ", i, j);
    }
    printf("\n");

    int k = 9;
    for (int i = 0; i < 3; i++, k--) {
        printf("%d%d ", i, k);
    }
    printf("\n");

    for (int i = 0, j = 5; i < j; i++, j--) {
        printf("%d%d ", i, j);
    }
    printf("\n");

    for (;;) {
        break;
    }

    return 0;
}
